{
    "$schema": "https://turbo.build/schema.json",
    "tasks": {
        "build": {
            "dependsOn": ["^build"],
            "outputs": [".next/**", "!.next/cache/**"]
        },
        "check-types": {
            "dependsOn": ["^check-types"]
        },
        "test": {
            "outputs": [],
            "inputs": [
                "src/**",
                "migrations/**",
                "vitest.config.ts",
                "package.json"
            ],
            "env": ["TEST_PG_URL"]
        },
        "dev": {
            "persistent": true,
            "cache": false
        }
    },
    "globalEnv": [
        "NEXT_PUBLIC_APP_URL",
        "BETTER_AUTH_SECRET",
        "BETTER_AUTH_URL",
        "BETTER_AUTH_BASE_URL",
        "DATABASE_URL",
        "POSTMARK_SERVER_TOKEN",
        "POSTMARK_WEBHOOK_USER",
        "POSTMARK_WEBHOOK_PASSWORD",
        "MAIL_FROM",
        "INBOUND_CONCERN_ADDRESS",
        "EMAIL_BATCH_SIZE",
        "EMAIL_BATCH_DELAY_MS",
        "GOOGLE_CLIENT_ID",
        "GOOGLE_CLIENT_SECRET",
        "PLAYER_PIC_URL",
        "SQUARE_ACCESS_TOKEN",
        "SQUARE_ENVIRONMENT",
        "NEXT_PUBLIC_SQUARE_APP_ID",
        "NEXT_PUBLIC_SQUARE_LOCATION_ID",
        "LIVEBLOCKS_SECRET_KEY",
        "R2_ACCOUNT_ID",
        "R2_ACCESS_KEY_ID",
        "R2_SECRET_ACCESS_KEY",
        "R2_BUCKET"
    ]
}
