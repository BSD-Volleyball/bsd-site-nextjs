{
    "name": "bsd-site-nextjs",
    "version": "0.0.5",
    "private": true,
    "engines": {
        "node": "24.x"
    },
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "start": "next start",
        "lint": "biome check",
        "check-types": "tsc --noEmit",
        "check-authz": "node scripts/security/authz-regression-check.js",
        "check-migrations": "tsx scripts/check-migration-drift.ts && drizzle-kit check",
        "db:generate": "DOTENV_CONFIG_PATH=.env.local drizzle-kit generate",
        "db:migrate": "DOTENV_CONFIG_PATH=.env.local tsx scripts/run-migration.ts",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:unit": "vitest run --project unit",
        "test:integration": "vitest run --project integration",
        "test:coverage": "vitest run --coverage",
        "test:e2e": "playwright test",
        "test:e2e:ui": "playwright test --ui",
        "worker:install": "pnpm --dir workers/postmark-inbound install --frozen-lockfile",
        "worker:check-types": "pnpm --dir workers/postmark-inbound check-types",
        "worker:test": "pnpm --dir workers/postmark-inbound test",
        "worker:deploy": "pnpm --dir workers/postmark-inbound deploy",
        "format": "biome check --write"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "^3.1146.0",
        "@aws-sdk/s3-request-presigner": "^3.1146.0",
        "@daveyplate/better-auth-ui": "^3.4.0",
        "@lexical/list": "^0.52.0",
