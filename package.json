        "server-only": "^0.0.1",
        "sonner": "^2.0.8",
        "square": "^46.0.0",
        "tailwind-merge": "^3.7.0",
        "zod": "4.6.5"
    },
    "devDependencies": {
        "@biomejs/biome": "2.5.15",
        "@playwright/test": "^1.63.0",
        "@tailwindcss/postcss": "^4.3.3",
        "@tailwindcss/typography": "^0.5.20",
        "@types/node": "^25.9.9",
        "@types/pg": "^8.23.1",
        "@types/qrcode": "^1.5.6",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "@vitest/coverage-v8": "^4.1.11",
        "dotenv": "^18.0.5",
        "drizzle-kit": "^0.31.11",
        "tailwindcss": "^4.3.3",
        "tsx": "^4.23.15",
        "tw-animate-css": "^1.4.0",
        "typescript": "^6.0.3",
