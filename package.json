    "overrides": {
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0"
    },
    "pnpm": {
        "overrides": {
            "tar": ">=7.5.7",
            "lodash": ">=4.17.23",
            "better-auth": "1.7.7",
            "esbuild": ">=0.28.0"
        }
    }
