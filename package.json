        "@react-email/render": "^2.1.0",
        "@remixicon/react": "^4.9.0",
        "@vercel/analytics": "^2.0.1",
        "@vercel/speed-insights": "^2.0.0",
        "better-auth": "1.7.7",
        "botid": "^1.5.11",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "drizzle-orm": "^0.45.3",
        "isomorphic-dompurify": "^3.19.0",
        "jpeg-js": "^0.4.4",
        "jsqr": "^1.4.0",
        "lexical": "^0.52.0",
        "motion": "^14.0.0",
        "next": "16.3.8",
        "next-themes": "0.4.6",
