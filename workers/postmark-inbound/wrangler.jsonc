{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "bsd-postmark-inbound",
    "main": "src/index.ts",
    "compatibility_date": "2026-09-11",
    // Postmark's inbound webhook URL points here (hooks.bumpsetdrink.com is a
    // custom domain on the bumpsetdrink.com zone; deploying creates the DNS
    // record). The Worker spools each POST into R2 and hands the Vercel app
    // only the object key, sidestepping Vercel's 4.5 MB request-body cap.
    "routes": [{ "pattern": "hooks.bumpsetdrink.com", "custom_domain": true }],
    "r2_buckets": [{ "binding": "SPOOL_BUCKET", "bucket_name": "bsd" }],
    "vars": {
        "ORIGIN_WEBHOOK_URL": "https://www.bumpsetdrink.com/api/webhooks/postmark"
    },
    // Secrets (wrangler secret put): WEBHOOK_USER, WEBHOOK_PASSWORD — the same
    // values as the Vercel app's POSTMARK_WEBHOOK_USER / POSTMARK_WEBHOOK_PASSWORD.
    "limits": { "cpu_ms": 30000 },
    "observability": {
        "enabled": true,
        "logs": { "enabled": true, "head_sampling_rate": 1 },
        "traces": { "enabled": true, "head_sampling_rate": 1 }
    }
}
