{
    "name": "bsd-pics-guard",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "description": "Keeps private R2 prefixes off the public pics domain and sandboxes sponsor-logo SVGs.",
    "scripts": {
        "deploy": "wrangler deploy",
        "types": "wrangler types",
        "check-types": "wrangler types && tsc --noEmit",
        "test": "vitest run"
    },
    "devDependencies": {
        "@cloudflare/vitest-plugin": "1.4.4",
        "typescript": "^5.9.3",
        "vitest": "^4.1.12",
        "wrangler": "4.151.1"
    },
    "pnpm": {
        "overrides": {
            "zod": "^4.6.6"
        },
        "onlyBuiltDependencies": [
            "workerd",
            "esbuild"
        ]
    },
    "packageManager": "pnpm@10.32.1+sha512.a706938f0e89ac1456b6563eab4edf1d1faf3368d1191fc5c59790e96dc918e4456ab2e67d613de1043d2e8c81f87303e6b40d4ffeca9df15ef1ad567348f2be"
}
