{
    "name": "bsd-pics-guard",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "description": "Keeps private R2 prefixes off the public pics domain and sandboxes sponsor-logo SVGs.",
    "scripts": {
        "deploy": "wrangler deploy",
        "types": "wrangler types",
        "check-types": "wrangler types && tsc --noEmit",
        "test": "vitest run"
    },
    "devDependencies": {
        "@cloudflare/vitest-plugin": "1.1.8",
        "typescript": "^5.9.3",
        "vitest": "^4.1.10",
        "wrangler": "4.131.1"
    },
    "pnpm": {
        "onlyBuiltDependencies": [
            "workerd",
            "esbuild"
        ]
    }
}
